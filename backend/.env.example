# Server
PORT=4040

# Admin Credentials
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=change-me-in-production

# JWT Secret
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# AWS DynamoDB
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
DYNAMODB_TABLE=adventra
# Override these during a staged KEYS_ONLY GSI migration after replacement indexes are ACTIVE.
DYNAMODB_GSI1_NAME=GSI1
DYNAMODB_GSI2_NAME=GSI2
DYNAMODB_GSI_KEYS_ONLY=false

# --- DynamoDB read path (see "Safe DynamoDB Scan Fix") ---
# GSI2 is the default so normal workflows and Tally exports never full-scan.
# Apply the index backfill before deploying against an existing table:
#   npx tsx scripts/backfill-gsi2.ts --apply
#   npx tsx scripts/backfill-gsi2.ts --verify   (must report incomplete: false)
# Emergency rollback to legacy table scans (do not leave enabled):
# DYNAMODB_SCAN_SOURCE=scan
# DYNAMODB_GSI2_VERIFIED=false
# DYNAMODB_READ_DIAGNOSTICS=false
# Total caps for non-Tally reads (Tally exports use the uncapped helper):
# DYNAMODB_MAX_SCAN_PAGES=400
# DYNAMODB_MAX_SCAN_ITEMS=200000
# DYNAMODB_SCAN_TIMEOUT_MS=120000
# DYNAMODB_WARN_SCAN_PAGES=20
# DYNAMODB_WARN_SCAN_ITEMS=10000

# AWS S3
S3_BUCKET=adventra

# --- SMTP (Invoice Reminder Emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
APP_URL=https://your-app-domain.com

# --- CORS ---
CORS_ORIGIN=https://your-app-domain.com

# --- Amazon SP-API / LFA Integration ---
# Register your app in Amazon Seller Central Developer Console to obtain these values.
AMAZON_CLIENT_ID=amzn1.application-oa2-client.your-client-id
AMAZON_CLIENT_SECRET=amzn1.oa2-cs.v1.your-client-secret
AMAZON_REFRESH_TOKEN=Atzr|your-refresh-token
AMAZON_APP_ID=amzn1.sp.solution.your-app-id
AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_MARKETPLACE_ID=your-marketplace-id
AMAZON_SELLER_ID=your-seller-id
AMAZON_REGION=eu-west-1
AMAZON_SYNC_LOOKBACK_DAYS=30
AMAZON_LFA_CLIENT_ID=your-lfa-client-id
AMAZON_LFA_CLIENT_SECRET=your-lfa-client-secret

# --- Amazon Application Review Status (optional developer declaration) ---
# Declare the current Amazon Public Developer review state. These are manual
# declarations only — never assumed from code. Leave unset to default to
# "pending/review pending" so production access is never misrepresented.
# AMAZON_DEVELOPER_REGISTRATION_STATUS=pending   # pending | approved | rejected
# AMAZON_PUBLIC_DEVELOPER_APPROVED=false         # true | false
# AMAZON_PRODUCTION_CLIENT_AVAILABLE=false       # true | false
# AMAZON_ROLE_APPROVAL_STATUS=pending            # pending | approved
# AMAZON_SELLER_AUTHORIZED=pending               # pending | authorized
# AMAZON_APPLICATION_STATUS=DRAFT                # DRAFT | production_enabled

# --- Flipkart Marketplace API ---
# Obtain these credentials from Flipkart Seller Hub (https://seller.flipkart.com) Developer Portal
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
FLIPKART_SELLER_ID=
FLIPKART_API_ENDPOINT=https://api.flipkart.net/sellers
FLIPKART_SANDBOX=false

# --- Myntra Seller API V4 (Pretr OMS) ---
# Merchant id + secret key come from Myntra onboarding (Mockify sheet for stage).
MYNTRA_MERCHANT_ID=
MYNTRA_SECRET_KEY=
# Stage (Neo-Mockify) domain; Myntra must whitelist our server IP. Production domain is shared after onboarding.
MYNTRA_API_DOMAIN=http://pretrtest-neo.myntapi.com
MYNTRA_PARTNER_STORE=Myntra
# Header value Myntra shares for stage testing only.
MYNTRA_MOCKING_PARTNER_NAME=
# Token Myntra must send in the access_token header when calling our outbound APIs.
MYNTRA_OUTBOUND_TOKEN=
# Public base of our outbound APIs, e.g. https://adventra.whizunikhub.com/api/myntra
MYNTRA_SELLER_DOMAIN=
# Local testing only (leave empty on the server): where Mockify pushes events when our URLs are not public.
MYNTRA_MOCK_PUSH_URL=

# --- Shopify Admin API (custom app in Shopify admin: Settings > Apps > Develop apps) ---
# Scopes: read_orders, read_products, read_inventory, read_returns
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SYNC_LOOKBACK_DAYS=60

# --- AJIO (no public seller API; fill in once AJIO shares API access) ---
AJIO_API_BASE_URL=
AJIO_SELLER_ID=
AJIO_API_KEY=
