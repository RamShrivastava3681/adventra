[TEMPLATE]
[TEMPLATE]
# --- Server ---
PORT=4040
NODE_ENV=development

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- DynamoDB ---
# If both AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set, they will
# be used directly. Otherwise the AWS SDK falls back to its default
# credential chain (IAM role, ~/.aws/credentials, etc.).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=InsightFactor

# Optional: set only when using DynamoDB Local (development only)
# DYNAMODB_ENDPOINT=http://localhost:8000

# --- S3 (optional - for document uploads) ---
# S3_BUCKET=my-uploads-bucket
# S3_BUCKET_REGION=us-east-1

# --- CORS ---
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=https://adventra.whizunikhub.com

# --- Amazon SP-API / LFA Integration ---
# AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxx
# AMAZON_CLIENT_SECRET=amzn1.oa2-cs.v1.xxx
# AMAZON_REFRESH_TOKEN=Atzr|...
# AMAZON_LFA_CLIENT_ID=amzn1.application-oa2-client.xxx
# AMAZON_LFA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxx

# --- Gemini AI (optional - reads uploaded purchase invoices / proformas) ---
# Without a key, only text PDFs are read; scanned PDFs and photos need it.
# Use a key from a billing-enabled (paid) Google project so invoice data
# is not used by Google for product improvement.
# GEMINI_API_KEY=
# Model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
