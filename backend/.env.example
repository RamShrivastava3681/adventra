# Server
PORT=4040

# Admin Credentials
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=change-me-in-production

# JWT Secret
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# AWS DynamoDB
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
DYNAMODB_TABLE=adventra

# AWS S3
S3_BUCKET=adventra

# --- SMTP (Invoice Reminder Emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
APP_URL=https://your-app-domain.com

# --- CORS ---
CORS_ORIGIN=https://your-app-domain.com

# --- Amazon SP-API / LFA Integration ---
# Register your app in Amazon Seller Central Developer Console to obtain these values.
AMAZON_CLIENT_ID=amzn1.application-oa2-client.your-client-id
AMAZON_CLIENT_SECRET=amzn1.oa2-cs.v1.your-client-secret
AMAZON_REFRESH_TOKEN=Atzr|your-refresh-token
AMAZON_APP_ID=amzn1.sp.solution.your-app-id
AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_MARKETPLACE_ID=your-marketplace-id
AMAZON_SELLER_ID=your-seller-id
AMAZON_REGION=eu-west-1
AMAZON_SYNC_LOOKBACK_DAYS=30
AMAZON_LFA_CLIENT_ID=your-lfa-client-id
AMAZON_LFA_CLIENT_SECRET=your-lfa-client-secret

# --- Amazon Application Review Status (optional developer declaration) ---
# Declare the current Amazon Public Developer review state. These are manual
# declarations only — never assumed from code. Leave unset to default to
# "pending/review pending" so production access is never misrepresented.
# AMAZON_DEVELOPER_REGISTRATION_STATUS=pending   # pending | approved | rejected
# AMAZON_PUBLIC_DEVELOPER_APPROVED=false         # true | false
# AMAZON_PRODUCTION_CLIENT_AVAILABLE=false       # true | false
# AMAZON_ROLE_APPROVAL_STATUS=pending            # pending | approved
# AMAZON_SELLER_AUTHORIZED=pending               # pending | authorized
# AMAZON_APPLICATION_STATUS=DRAFT                # DRAFT | production_enabled
