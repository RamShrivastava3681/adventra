{
  "name": "whizunik-cloud-connector",
  "version": "1.0.0",
  "description": "Cloud-native bidirectional data connector between WhizUnik cloud and the Tally desktop connector",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cmd/main.ts",
    "build": "tsc",
    "start": "node dist/cmd/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pino": "^8.21.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
