# ===========================================================================
# WhizUnik Cloud Connector — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values before running.

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
REQUEST_ID_HEADER=x-request-id

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
TRUST_PROXY=1

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=1

# ── PostgreSQL (primary) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=connector
DB_PASSWORD=connector_password
DB_NAME=connector_db
DB_SSL=false
DB_MAX_CONNECTIONS=10

# ── Redis (cache, rate limiting, idempotency store) ────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Repository driver: inmemory | postgres (defaults to inmemory for local dev) ───
REPO_DRIVER=inmemory

# ── Connector (Tally) credentials ──────────────────────────────────────────
CONNECTOR_BASE_URL=http://localhost:8080
CONNECTOR_API_KEY=
CONNECTOR_WEBHOOK_SECRET=dev-webhook-secret-change-in-production
CONNECTOR_TIMEOUT_MS=30000
CONNECTOR_MAX_RETRIES=5

# ── Sync ───────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=500
TALLY_PUSH_ENABLED=true
FEATURE_INBOUND=true
FEATURE_OUTBOUND=true

# ── Security ───────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────
FEATURE_WEBHOOK_SIG_VERIFY=true
